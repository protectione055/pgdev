#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import List, Optional


def load_config(config_path: Path) -> dict:
    with config_path.open("r", encoding="utf-8") as f:
        return json.load(f)


def resolve_profile(inst: dict, profile: Optional[str]) -> str:
    if profile:
        return profile
    if "defaultProfile" in inst:
        return inst["defaultProfile"]
    if "profiles" in inst and "debug" in inst["profiles"]:
        return "debug"
    if "profiles" in inst and inst["profiles"]:
        return next(iter(inst["profiles"].keys()))
    return "default"


def resolve_instance(cfg: dict, name: str, profile: Optional[str]) -> dict:
    instances = cfg.get("instances", {})
    if name not in instances:
        raise KeyError(f"Unknown instance: {name}")
    inst = instances[name]
    profile = resolve_profile(inst, profile)
    profiles = inst.get("profiles", {})
    prof = profiles.get(profile, {})

    raw_port = prof.get("port")
    if raw_port is None:
        raw_port = inst.get("port")
    port = None
    if raw_port is not None:
        port = str(raw_port).strip()

    paths = cfg.get("paths", {})
    variant = inst.get("variant", "unknown")
    version = inst.get("version", "unknown")
    build_root = Path(paths.get("buildRoot", "."))
    install_root = Path(paths.get("installRoot", "."))
    data_root = Path(paths.get("dataRoot", "."))
    log_root = Path(paths.get("logRoot", "."))
    build_system = inst.get("buildSystem", "configure")
    repo_dir = Path(inst["repo"]) if inst.get("repo") else None
    if build_system == "configure" and repo_dir:
        build_dir = repo_dir
    else:
        build_dir = build_root / variant / version / profile
    install_dir = install_root / variant / version / profile
    data_dir = data_root / variant / version / profile
    log_dir = log_root / variant / version / profile

    return {
        "name": name,
        "displayName": inst.get("displayName", name),
        "repo": inst.get("repo"),
        "buildSystem": build_system,
        "profile": profile,
        "port": port,
        "variant": variant,
        "version": version,
        "configure": prof.get("configure", []),
        "cflags": prof.get("cflags", ""),
        "buildDir": str(build_dir),
        "installDir": str(install_dir),
        "dataDir": str(data_dir),
        "logDir": str(log_dir),
    }


def run(cmd: List[str], cwd: Optional[str] = None, env: Optional[dict] = None) -> None:
    subprocess.run(cmd, cwd=cwd, env=env, check=True)


def ensure_dir(path: str) -> None:
    Path(path).mkdir(parents=True, exist_ok=True)


def cmd_list(cfg: dict) -> int:
    for name, inst in cfg.get("instances", {}).items():
        display = inst.get("displayName", name)
        print(f"{name}\t{display}")
    return 0


def cmd_info(cfg: dict, name: str, profile: Optional[str]) -> int:
    inst = resolve_instance(cfg, name, profile)
    for k in (
        "name",
        "displayName",
        "repo",
        "buildSystem",
        "variant",
        "version",
        "profile",
        "port",
        "buildDir",
        "installDir",
        "dataDir",
        "logDir",
        "cflags",
    ):
        print(f"{k}={inst.get(k, '')}")
    print(f"configure={' '.join(inst.get('configure', []))}")
    return 0


def env_lines(inst: dict) -> List[str]:
    install_dir = inst["installDir"]
    data_dir = inst["dataDir"]
    log_dir = inst["logDir"]
    repo_dir = inst["repo"] or ""
    build_dir = inst["buildDir"]
    lines = [
        f"export PGDEV_ACTIVE={inst['name']}:{inst['profile']}",
        f"export PGHOME={install_dir}",
        f"export PGSRC={repo_dir}",
        f"export PGBUILD={build_dir}",
        f"export PGDATA={data_dir}",
        f"export PGLOGDIR={log_dir}",
        f"export PG_CONFIG={install_dir}/bin/pg_config",
        f"export PGXS={install_dir}/lib/postgresql/pgxs/src/makefiles/pgxs.mk",
        "export PATH=\"${PGHOME}/bin:${PATH}\"",
        "export LD_LIBRARY_PATH=\"${PGHOME}/lib:${LD_LIBRARY_PATH:-}\"",
        "export MANPATH=\"${PGHOME}/share/man:${MANPATH:-}\"",
    ]

    port = inst.get("port")
    if port:
        lines.append(f"export PGPORT={port}")
    return lines


def cmd_env(cfg: dict, name: str, profile: Optional[str]) -> int:
    inst = resolve_instance(cfg, name, profile)
    for line in env_lines(inst):
        print(line)
    return 0


def cmd_use(cfg: dict, name: str, profile: Optional[str]) -> int:
    inst = resolve_instance(cfg, name, profile)
    base_dir = Path(cfg.get("baseDir", "."))
    env_file = base_dir / "active.env"
    ensure_dir(inst["dataDir"])
    ensure_dir(inst["logDir"])
    with env_file.open("w", encoding="utf-8") as f:
        f.write("# Generated by pgdev\n")
        for line in env_lines(inst):
            f.write(line + "\n")
    print(f"source {env_file}")
    return 0


def cmd_build(cfg: dict, name: str, profile: Optional[str], auto_install: bool) -> int:
    inst = resolve_instance(cfg, name, profile)
    repo = inst["repo"]
    if not repo or not Path(repo).exists():
        raise SystemExit(f"repo not found: {repo}")

    build_dir = inst["buildDir"]
    install_dir = inst["installDir"]
    ensure_dir(build_dir)
    ensure_dir(install_dir)

    if inst["buildSystem"] == "configure":
        config_stamp = Path(build_dir) / ".pgdev.config"
        cfg_payload = {
            "configure": inst.get("configure", []),
            "cflags": inst.get("cflags", ""),
            "prefix": install_dir,
        }
        reconfigure = True
        if config_stamp.exists():
            try:
                if json.loads(config_stamp.read_text(encoding="utf-8")) == cfg_payload:
                    reconfigure = False
            except Exception:
                reconfigure = True

        if reconfigure:
            env = os.environ.copy()
            cflags = inst.get("cflags", "")
            if cflags:
                env["CFLAGS"] = f"{cflags} {env.get('CFLAGS', '')}".strip()
            cmd = [str(Path(repo) / "configure"), f"--prefix={install_dir}"]
            cmd += inst.get("configure", [])
            run(cmd, cwd=build_dir, env=env)
            config_stamp.write_text(json.dumps(cfg_payload, indent=2), encoding="utf-8")

        run(["make", f"-j{os.cpu_count() or 4}"], cwd=build_dir)

        if auto_install:
            pg_config_path = Path(install_dir) / "bin" / "pg_config"
            if not pg_config_path.exists():
                run(["make", "install"], cwd=build_dir)
        return 0

    if inst["buildSystem"] == "meson":
        build_dir_path = Path(build_dir)
        meson_build = build_dir_path / "build.ninja"
        if not meson_build.exists():
            run(["meson", "setup", build_dir, repo, f"-Dprefix={install_dir}"])
        run(["ninja", "-C", build_dir])
        if auto_install:
            pg_config_path = Path(install_dir) / "bin" / "pg_config"
            if not pg_config_path.exists():
                run(["ninja", "-C", build_dir, "install"])
        return 0

    raise SystemExit(f"Unsupported buildSystem: {inst['buildSystem']}")


def cmd_install(cfg: dict, name: str, profile: Optional[str]) -> int:
    inst = resolve_instance(cfg, name, profile)
    build_dir = inst["buildDir"]
    if not Path(build_dir).exists():
        raise SystemExit(f"build dir not found: {build_dir}")

    if inst["buildSystem"] == "configure":
        run(["make", "install"], cwd=build_dir)
        return 0

    if inst["buildSystem"] == "meson":
        run(["ninja", "-C", build_dir, "install"])
        return 0

    raise SystemExit(f"Unsupported buildSystem: {inst['buildSystem']}")


def cmd_clean(cfg: dict, name: str, profile: Optional[str]) -> int:
    inst = resolve_instance(cfg, name, profile)
    build_dir = Path(inst["buildDir"])
    repo_dir = Path(inst["repo"]) if inst.get("repo") else None
    if repo_dir and build_dir.resolve() == repo_dir.resolve():
        if inst["buildSystem"] == "configure":
            if (build_dir / "Makefile").exists():
                run(["make", "clean"], cwd=str(build_dir))
        elif inst["buildSystem"] == "meson":
            if (build_dir / "build.ninja").exists():
                run(["ninja", "-C", str(build_dir), "clean"])
        return 0
    if build_dir.exists():
        shutil.rmtree(build_dir)
    return 0


def cmd_status(cfg: dict, name: str) -> int:
    inst = resolve_instance(cfg, name, None)
    repo = inst["repo"]
    if not repo or not Path(repo).exists():
        raise SystemExit(f"repo not found: {repo}")
    run(["git", "-C", repo, "status", "-sb"])
    return 0


def cmd_gdb(cfg: dict, script: Optional[str], list_only: bool) -> int:
    base_dir = Path(cfg.get("baseDir", "."))
    gdb_dir = base_dir / "gdb"
    scripts = {
        "pgnode": "pg_print_tree_gdb.py",
        "pgjson": "pg_printer.py",
        "printslot": "table_slot_printer.py",
    }

    if list_only:
        for name, filename in scripts.items():
            print(f"{name}\t{gdb_dir / filename}")
        return 0

    if not script or script == "all":
        for filename in scripts.values():
            print(f"source {gdb_dir / filename}")
        return 0

    if script in scripts:
        print(f"source {gdb_dir / scripts[script]}")
        return 0

    # allow passing a filename directly
    candidate = gdb_dir / script
    if candidate.exists():
        print(f"source {candidate}")
        return 0

    raise SystemExit(f"unknown gdb script: {script}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="pg")
    parser.add_argument(
        "--config",
        default=os.environ.get("PGDEV_CONFIG"),
        help="Path to pgfleet.json (default: PGDEV_CONFIG or ../pgfleet.json)",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list")

    info = sub.add_parser("info")
    info.add_argument("name")
    info.add_argument("profile", nargs="?")

    env = sub.add_parser("env")
    env.add_argument("name")
    env.add_argument("profile", nargs="?")

    use = sub.add_parser("use")
    use.add_argument("name")
    use.add_argument("profile", nargs="?")

    build = sub.add_parser("build")
    build.add_argument("name")
    build.add_argument("profile", nargs="?")
    build.add_argument("--no-install", action="store_true")

    install = sub.add_parser("install")
    install.add_argument("name")
    install.add_argument("profile", nargs="?")

    clean = sub.add_parser("clean")
    clean.add_argument("name")
    clean.add_argument("profile", nargs="?")

    status = sub.add_parser("status")
    status.add_argument("name")

    gdb_cmd = sub.add_parser("gdb")
    gdb_cmd.add_argument("script", nargs="?", default="all")
    gdb_cmd.add_argument("--list", action="store_true")

    args = parser.parse_args()

    config_path = args.config
    if not config_path:
        config_path = str(Path(__file__).resolve().parent.parent / "pgfleet.json")
    cfg = load_config(Path(config_path))

    if args.cmd == "list":
        return cmd_list(cfg)
    if args.cmd == "info":
        return cmd_info(cfg, args.name, args.profile)
    if args.cmd == "env":
        return cmd_env(cfg, args.name, args.profile)
    if args.cmd == "use":
        return cmd_use(cfg, args.name, args.profile)
    if args.cmd == "build":
        return cmd_build(cfg, args.name, args.profile, auto_install=not args.no_install)
    if args.cmd == "install":
        return cmd_install(cfg, args.name, args.profile)
    if args.cmd == "clean":
        return cmd_clean(cfg, args.name, args.profile)
    if args.cmd == "status":
        return cmd_status(cfg, args.name)
    if args.cmd == "gdb":
        return cmd_gdb(cfg, args.script, args.list)

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
